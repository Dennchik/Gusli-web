//- Автономная демо-страница: собственные шапка, футер, кнопки и формы
//- (не использует глобальные компоненты проекта)
doctype html
html(lang="ru")
	head
		meta(charset="UTF-8")
		meta(name="viewport" content="width=device-width, initial-scale=1.0")
		title ITAgency — цифровые решения для бизнеса
		link(rel="preconnect" href="https://fonts.googleapis.com")
		link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="")
		link(href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap" rel="stylesheet")
		script(defer type="module" src="/src/js/templates/template-2.js")
	body.tmpl2
		//- Статичный фон всей страницы: плексус-сетка + рука, не скроллится
		.tmpl2-bg(aria-hidden="true")
			svg.tmpl2-bg__plexus(viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" fill="none")
				g(stroke="rgb(255 255 255 / 8%)" stroke-width="1")
					path(d="M-40 140 L210 60 L470 190 L740 80 L980 210")
					path(d="M210 60 L300 340 L90 560 L-40 500")
					path(d="M300 340 L620 420 L740 80")
					path(d="M620 420 L900 620 L1210 480 L1420 640 L1600 560")
					path(d="M980 210 L1210 480 L1330 180 L1600 120")
					path(d="M900 620 L820 860 L1140 920")
					path(d="M1210 480 L1380 760 L1600 700")
					path(d="M470 190 L520 460 L300 340")
					path(d="M-40 760 L240 700 L520 460")
				g(fill="rgb(255 255 255 / 26%)")
					circle(cx="210" cy="60" r="3")
					circle(cx="470" cy="190" r="2.4")
					circle(cx="740" cy="80" r="3")
					circle(cx="980" cy="210" r="2.4")
					circle(cx="300" cy="340" r="3")
					circle(cx="620" cy="420" r="2.4")
					circle(cx="90" cy="560" r="2.6")
					circle(cx="900" cy="620" r="3")
					circle(cx="1210" cy="480" r="2.4")
					circle(cx="1420" cy="640" r="2.8")
					circle(cx="1330" cy="180" r="2.4")
					circle(cx="820" cy="860" r="2.6")
					circle(cx="1380" cy="760" r="2.4")
					circle(cx="520" cy="460" r="2.6")
					circle(cx="240" cy="700" r="2.4")
			img.tmpl2-bg__hand(src="/img/template/template-2/hand-ia-bgremove.webp" alt="" loading="eager")
		header.tmpl2-header#tmpl2-header
			.tmpl2-header__inner
				a.tmpl2-header__logo(href="#tmpl2-top")
					svg.tmpl2-header__mark(width="38" height="38" viewBox="0 0 40 40" aria-hidden="true")
						circle(cx="20" cy="20" r="19" fill="#2f80ed")
						path(d="M12 15l9-4M12 15l15 6M21 11l4 10" stroke="#fff" stroke-width="1.6" fill="none")
						circle(cx="12" cy="15" r="2.4" fill="#fff")
						circle(cx="21" cy="11" r="2" fill="#fff")
						circle(cx="27" cy="21" r="2.2" fill="#fff")
					| ITAgency
				nav.tmpl2-header__nav
					a.tmpl2-header__link.tmpl2-header__link--drop(href="#tmpl2-top") Главная
					a.tmpl2-header__link(href="#tmpl2-about") О нас
					a.tmpl2-header__link(href="#tmpl2-works") Услуги
					a.tmpl2-header__link(href="#tmpl2-works") Портфолио
					a.tmpl2-header__link.tmpl2-header__link--drop(href="#tmpl2-blog") Блог
					a.tmpl2-header__link(href="#tmpl2-contact") Контакты
				a.tmpl2-btn.tmpl2-btn--solid.tmpl2-header__cta(href="#tmpl2-contact") Получить смету
				button.tmpl2-burger(type="button" aria-label="Меню")
					span
					span
					span
		main#tmpl2-top
			//- ─────────── Блок 1: hero (прозрачный — фон виден) ───────────
			section.tmpl2-hero.container
				.tmpl2-hero__content
					h1.tmpl2-hero__title(data-anim)
						| Технологичные решения
						span.tmpl2-hero__accent в дата-аналитике
					p.tmpl2-hero__text(data-anim)
						| Помогаем бизнесу расти через стратегию, креатив и технологии.
					.tmpl2-hero__socials(data-anim)
						a(href="#" aria-label="X")
							svg(width="18" height="18" viewBox="0 0 24 24" fill="currentColor")
								path(d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z")
						a(href="#" aria-label="Facebook")
							svg(width="18" height="18" viewBox="0 0 24 24" fill="currentColor")
								path(d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z")
						a(href="#" aria-label="LinkedIn")
							svg(width="18" height="18" viewBox="0 0 24 24" fill="currentColor")
								path(d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z")
						a(href="#" aria-label="Instagram")
							svg(width="18" height="18" viewBox="0 0 24 24" fill="currentColor")
								path(d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z")
					.tmpl2-hero__actions(data-anim)
						a.tmpl2-btn.tmpl2-btn--solid(href="#tmpl2-contact") Получить смету
						a.tmpl2-btn.tmpl2-btn--navy(href="#tmpl2-works") Начать работу
		//- ───────────────────── Footer ─────────────────────
		footer.tmpl2-footer#tmpl2-contact
			.tmpl2-footer__inner
				.tmpl2-footer__brand
					p.tmpl2-footer__logo ITA<span>gency</span>
					p.tmpl2-footer__desc
						| Студия дизайна и разработки. Страница собирается блоками —
						|  новые секции добавляются перед футером.
				.tmpl2-footer__col
					p.tmpl2-footer__title Навигация
					a.tmpl2-footer__link(href="#tmpl2-top") Главная
					a.tmpl2-footer__link(href="#tmpl2-works") Работы
					a.tmpl2-footer__link(href="#tmpl2-process") Процесс
					a.tmpl2-footer__link(href="#tmpl2-top") Наверх
			.tmpl2-footer__bottom
				p.tmpl2-footer__copy © 2026 ITAgency
