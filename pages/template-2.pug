//- Автономная демо-страница: собственные шапка, футер, кнопки и формы
//- (не использует глобальные компоненты проекта)
doctype html
html(lang="ru")
	head
		meta(charset="UTF-8")
		meta(name="viewport" content="width=device-width, initial-scale=1.0")
		title ITAgency — цифровые решения для бизнеса
		link(rel="preconnect" href="https://fonts.googleapis.com")
		link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="")
		link(href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap" rel="stylesheet")
		script(defer type="module" src="/src/js/templates/template-2.js")
		script(defer type="module" src="/src/js/templates/template-3.js")
	body.tmpl3
		//- Статичный фон всей страницы: плексус-сетка + рука, не скроллится
		.tmpl2-bg(aria-hidden="true")
			svg.tmpl2-bg__plexus(viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" fill="none")
				g(stroke="rgb(255 255 255 / 8%)" stroke-width="1")
					path(d="M-40 140 L210 60 L470 190 L740 80 L980 210")
					path(d="M210 60 L300 340 L90 560 L-40 500")
					path(d="M300 340 L620 420 L740 80")
					path(d="M620 420 L900 620 L1210 480 L1420 640 L1600 560")
					path(d="M980 210 L1210 480 L1330 180 L1600 120")
					path(d="M900 620 L820 860 L1140 920")
					path(d="M1210 480 L1380 760 L1600 700")
					path(d="M470 190 L520 460 L300 340")
					path(d="M-40 760 L240 700 L520 460")
				g(fill="rgb(255 255 255 / 26%)")
					circle(cx="210" cy="60" r="3")
					circle(cx="470" cy="190" r="2.4")
					circle(cx="740" cy="80" r="3")
					circle(cx="980" cy="210" r="2.4")
					circle(cx="300" cy="340" r="3")
					circle(cx="620" cy="420" r="2.4")
					circle(cx="90" cy="560" r="2.6")
					circle(cx="900" cy="620" r="3")
					circle(cx="1210" cy="480" r="2.4")
					circle(cx="1420" cy="640" r="2.8")
					circle(cx="1330" cy="180" r="2.4")
					circle(cx="820" cy="860" r="2.6")
					circle(cx="1380" cy="760" r="2.4")
					circle(cx="520" cy="460" r="2.6")
					circle(cx="240" cy="700" r="2.4")
			img.tmpl2-bg__hand(src="/img/template/template-2/hand-ia-bgremove.webp" alt="" loading="eager")
		header.tmpl2-header#tmpl2-header
			.tmpl2-header__inner
				a.tmpl2-header__logo(href="#tmpl2-top")
					svg.tmpl2-header__mark(width="38" height="38" viewBox="0 0 40 40" aria-hidden="true")
						circle(cx="20" cy="20" r="19" fill="#2f80ed")
						path(d="M12 15l9-4M12 15l15 6M21 11l4 10" stroke="#fff" stroke-width="1.6" fill="none")
						circle(cx="12" cy="15" r="2.4" fill="#fff")
						circle(cx="21" cy="11" r="2" fill="#fff")
						circle(cx="27" cy="21" r="2.2" fill="#fff")
					| ITAgency
				nav.tmpl2-header__nav
					a.tmpl2-header__link.tmpl2-header__link--drop(href="#tmpl2-top") Главная
					a.tmpl2-header__link(href="#tmpl2-about") О нас
					a.tmpl2-header__link(href="#tmpl2-works") Услуги
					a.tmpl2-header__link(href="#tmpl2-works") Портфолио
					a.tmpl2-header__link.tmpl2-header__link--drop(href="#tmpl2-blog") Блог
					a.tmpl2-header__link(href="#tmpl2-contact") Контакты
				a.tmpl2-btn.tmpl2-btn--solid.tmpl2-header__cta(href="#tmpl2-contact") Получить смету
				button.tmpl2-burger(type="button" aria-label="Меню")
					span
					span
					span
		main#tmpl2-top
			//- ─────────── Блок 1: hero (прозрачный — фон виден) ───────────
			section.tmpl2-hero.container
				.tmpl2-hero__content
					h1.tmpl2-hero__title(data-anim)
						| Технологичные решения
						span.tmpl2-hero__accent в дата-аналитике
					p.tmpl2-hero__text(data-anim)
						| Помогаем бизнесу расти через стратегию, креатив и технологии.
					.tmpl2-hero__socials(data-anim)
						a(href="#" aria-label="X")
							svg(width="18" height="18" viewBox="0 0 24 24" fill="currentColor")
								path(d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z")
						a(href="#" aria-label="Facebook")
							svg(width="18" height="18" viewBox="0 0 24 24" fill="currentColor")
								path(d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z")
						a(href="#" aria-label="LinkedIn")
							svg(width="18" height="18" viewBox="0 0 24 24" fill="currentColor")
								path(d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z")
						a(href="#" aria-label="Instagram")
							svg(width="18" height="18" viewBox="0 0 24 24" fill="currentColor")
								path(d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z")
					.tmpl2-hero__actions(data-anim)
						a.tmpl2-btn.tmpl2-btn--solid(href="#tmpl2-contact") Получить смету
						a.tmpl2-btn.tmpl2-btn--navy(href="#tmpl2-works") Начать работу
			//- ───────────────────── Услуги ─────────────────────
			section.tmpl3-services.tmpl3-dark
				.container.tmpl3-services__inner
					.tmpl3-services__head
						h2.tmpl3-services__title(data-anim) Наши услуги
						a.tmpl3-btn.tmpl3-btn--solid.tmpl3-services__cta(href="#") Все услуги
					.tmpl3-services__grid
						article.tmpl3-services__card(data-anim)
							svg.tmpl3-services__icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round")
								rect(x="2" y="4" width="20" height="13" rx="1.5")
								path(d="M8 21h8M12 17v4")
								path(d="M10.5 8.5 8 10.5l2.5 2M13.5 8.5l2.5 2-2.5 2")
							h3.tmpl3-services__name Веб-разработка
							p.tmpl3-services__desc Профессиональные веб-решения на современных технологиях с адаптивным дизайном.
						article.tmpl3-services__card(data-anim)
							svg.tmpl3-services__icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round")
								rect(x="6" y="2" width="12" height="20" rx="2.5")
								path(d="M10.5 19h3")
							h3.tmpl3-services__name Разработка мобильных приложений
							p.tmpl3-services__desc Нативные и кроссплатформенные приложения для iOS и Android.
						article.tmpl3-services__card(data-anim)
							svg.tmpl3-services__icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round")
								path(d="M17.5 18a4.5 4.5 0 0 0 0-9 6 6 0 0 0-11.4 1.6A4 4 0 0 0 6 18.5")
								path(d="M9 18v-2.4a1.5 1.5 0 0 1 1.5-1.5h3a1.5 1.5 0 0 1 1.5 1.5V18")
							h3.tmpl3-services__name Облачные решения
							p.tmpl3-services__desc Масштабируемая облачная инфраструктура и деплой для вашего бизнеса.
						article.tmpl3-services__card(data-anim)
							svg.tmpl3-services__icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round")
								rect(x="2" y="5" width="20" height="12" rx="1.5")
								path(d="M8 21h8M12 17v4")
								text(x="12" y="13.5" text-anchor="middle" fill="currentColor" stroke="none" style="font: 700 5px var(--font-family)") SEO
							h3.tmpl3-services__name Цифровой маркетинг
							p.tmpl3-services__desc Стратегические кампании для усиления онлайн-присутствия.
						article.tmpl3-services__card(data-anim)
							svg.tmpl3-services__icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round")
								path(d="M5 5h5M14 5h5M7.5 5v4.5M16.5 5v4.5")
								circle(cx="7.5" cy="13" r="3.5")
								circle(cx="16.5" cy="13" r="3.5")
								path(d="M11 13h2M7.5 16.5V19M16.5 16.5V19M7.5 19h3M13.5 19h3")
							h3.tmpl3-services__name UX/UI дизайн
							p.tmpl3-services__desc Интерфейсы, ориентированные на пользователя, которые вовлекают и конвертируют.
						article.tmpl3-services__card(data-anim)
							svg.tmpl3-services__icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round")
								ellipse(cx="12" cy="5.5" rx="8" ry="3")
								path(d="M4 5.5V12c0 1.66 3.58 3 8 3s8-1.34 8-3V5.5")
								path(d="M4 12v6.5c0 1.66 3.58 3 8 3s8-1.34 8-3V12")
							h3.tmpl3-services__name Аналитика данных
							p.tmpl3-services__desc Превращаем данные в практические инсайты для бизнес-решений.

			//- ─────────── О компании: прогресс-бары + изображение ───────────
			section.tmpl3-about#tmpl3-about
				.tmpl3-about__inner
					.tmpl3-about__content
						p.section-subtitle.tmpl3-about__subtitle(data-anim) О нашей компании
						h2.section-title.tmpl3-about__title(data-anim)
							| Мы увлечены качеством,
							br
							| которое выводит
							span  ваш бизнес
							|  на новый уровень.
						p.tmpl3-about__desc(data-anim)
							| Мы соединяем стратегию, дизайн и технологии: каждый проект
							|  начинаем с исследования, а сдаём только то, что измеримо
							|  усиливает ваш бизнес.
						.tmpl3-about__skills(data-anim)
							.tmpl3-skill
								.tmpl3-skill__head
									span.tmpl3-skill__name IT-консалтинг
									b.tmpl3-skill__value 90%
								.tmpl3-skill__bar
									span.tmpl3-skill__fill(style="--w: 90%")
							.tmpl3-skill
								.tmpl3-skill__head
									span.tmpl3-skill__name Веб-разработка
									b.tmpl3-skill__value 75%
								.tmpl3-skill__bar
									span.tmpl3-skill__fill(style="--w: 75%")
							.tmpl3-skill
								.tmpl3-skill__head
									span.tmpl3-skill__name UX/UI дизайн
									b.tmpl3-skill__value 70%
								.tmpl3-skill__bar
									span.tmpl3-skill__fill(style="--w: 70%")
					.tmpl3-about__media(data-anim)
						img(src="/img/template/template-3/computer-code.webp" alt="Работа над проектом")

			//- ─────────── Процесс: 4 шага вокруг круглого фото ───────────
			section.tmpl3-process#tmpl3-process
				.tmpl3-process__inner
					.tmpl3-step.tmpl3-step--1(data-anim)
						.tmpl3-step__icon
							svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
								polyline(points="8 6 3 12 8 18")
								polyline(points="16 6 21 12 16 18")
								line(x1="13.5" y1="5" x2="10.5" y2="19")
						.tmpl3-step__body
							h3.tmpl3-step__title 1. Мы исследуем и планируем
							p.tmpl3-step__desc
								| Анализируем требования и создаём комплексную стратегию,
								|  tailored под цели вашего бизнеса.
					figure.tmpl3-process__media(data-anim)
						img(src="/img/template/template-3/process.webp" alt="Процесс работы")
					.tmpl3-step.tmpl3-step--2(data-anim)
						.tmpl3-step__icon
							svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
								rect(x="2" y="4" width="20" height="13" rx="1.5")
								path(d="M8 21h8M12 17v4")
								polyline(points="10.5 8.5 8 10.5 10.5 12.5")
								polyline(points="13.5 8.5 16 10.5 13.5 12.5")
						.tmpl3-step__body
							h3.tmpl3-step__title 2. Совместно создаём и разрабатываем
							p.tmpl3-step__desc
								| Работая вместе, мы строим инновационные решения на
								|  передовых технологиях и лучших практиках.
					.tmpl3-step.tmpl3-step--3(data-anim)
						.tmpl3-step__icon
							svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
								path(d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z")
								polyline(points="9 11.5 11.2 13.7 15.5 9.5")
						.tmpl3-step__body
							h3.tmpl3-step__title 3. Сопровождаем и гарантируем
							p.tmpl3-step__desc
								| Обеспечиваем поддержку и обслуживание, чтобы ваше
								|  решение работало оптимально со временем.
					.tmpl3-step.tmpl3-step--4(data-anim)
						.tmpl3-step__icon
							svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
								path(d="M21 8l-9-6-9 6v8l9 6 9-6V8z")
								path(d="M3 8l9 6 9-6M12 22v-8")
						.tmpl3-step__body
							h3.tmpl3-step__title 4. Запускаем и передаём
							p.tmpl3-step__desc
								| Внедряем решение с тщательным тестированием и
								|  бесшовной реализацией.

			//- ─────────── Портфолио: фильтр + сетка проектов ───────────
			section.tmpl3-portfolio.tmpl3-dark#tmpl3-portfolio
				.container.tmpl3-portfolio__inner
					h2.tmpl3-portfolio__title(data-anim) Наше портфолио
					.tmpl3-portfolio__tabs(data-anim)
						button.tmpl3-portfolio__tab.is-active(type="button" data-filter="all") Все проекты
						button.tmpl3-portfolio__tab(type="button" data-filter="web") Веб-разработка
						button.tmpl3-portfolio__tab(type="button" data-filter="mobile") Мобильные приложения
						button.tmpl3-portfolio__tab(type="button" data-filter="uiux") UI/UX дизайн
						button.tmpl3-portfolio__tab(type="button" data-filter="branding") Брендинг
					.tmpl3-portfolio__grid
						article.tmpl3-portfolio__card(data-category="web" data-anim)
							.tmpl3-portfolio__media
								img(src="/img/template/template-3/project-1.webp" alt="Платформа e-commerce")
							.tmpl3-portfolio__body
								h3.tmpl3-portfolio__name Платформа e-commerce
								p.tmpl3-portfolio__cat Веб-разработка
						article.tmpl3-portfolio__card(data-category="mobile" data-anim)
							.tmpl3-portfolio__media
								img(src="/img/template/template-3/project-2.webp" alt="Приложение фитнес-трекер")
							.tmpl3-portfolio__body
								h3.tmpl3-portfolio__name Приложение фитнес-трекер
								p.tmpl3-portfolio__cat Мобильные приложения
						article.tmpl3-portfolio__card(data-category="uiux" data-anim)
							.tmpl3-portfolio__media
								img(src="/img/template/template-3/project-3.webp" alt="Банковский дашборд")
							.tmpl3-portfolio__body
								h3.tmpl3-portfolio__name Банковский дашборд
								p.tmpl3-portfolio__cat UI/UX дизайн
						article.tmpl3-portfolio__card(data-category="mobile" data-anim)
							.tmpl3-portfolio__media
								img(src="/img/template/template-3/project-4.webp" alt="Приложение для путешествий")
							.tmpl3-portfolio__body
								h3.tmpl3-portfolio__name Приложение для путешествий
								p.tmpl3-portfolio__cat Мобильные приложения
						article.tmpl3-portfolio__card(data-category="branding" data-anim)
							.tmpl3-portfolio__media
								img(src="/img/template/template-3/project-5.webp" alt="Бренд IT-стартапа")
							.tmpl3-portfolio__body
								h3.tmpl3-portfolio__name Бренд IT-стартапа
								p.tmpl3-portfolio__cat Брендинг
						article.tmpl3-portfolio__card(data-category="web" data-anim)
							.tmpl3-portfolio__media
								img(src="/img/template/template-3/project-6.webp" alt="Сайт ресторана")
							.tmpl3-portfolio__body
								h3.tmpl3-portfolio__name Сайт ресторана
								p.tmpl3-portfolio__cat Веб-разработка

			//- ─────────── Логотипы компаний: слайдер на 12 карточек ───────────
			section.tmpl3-companies#tmpl3-companies
				.tmpl3-companies__container
					h2.tmpl3-companies__title(data-anim) Строим успех вместе с великими компаниями
					.tmpl3-companies__viewport
						.tmpl3-companies__track
							- for (let i = 0; i < 2; i++)
							img.tmpl3-companies__card(src="/img/template/template-3/company-01.webp" alt="Компания 1" loading="lazy")
							img.tmpl3-companies__card(src="/img/template/template-3/company-02.webp" alt="Компания 2" loading="lazy")
							img.tmpl3-companies__card(src="/img/template/template-3/company-03.webp" alt="Компания 3" loading="lazy")
							img.tmpl3-companies__card(src="/img/template/template-3/company-04.webp" alt="Компания 4" loading="lazy")
