//- Автономная демо-страница: собственные шапка, футер, кнопки и формы
//- (не использует глобальные компоненты проекта)
doctype html
html(lang="ru")
	head
		meta(charset="UTF-8")
		meta(name="viewport" content="width=device-width, initial-scale=1.0")
		title LUMIÈRE — ресторан авторской кухни
		script(defer type="module" src="/src/js/templates/template-1.js")
	body.tmpl1
		header.tmpl1-header#tmpl1-header
			.tmpl1-header__inner.container
				a.tmpl1-header__logo(href="#tmpl1-top") LUMIÈRE
				nav.tmpl1-header__nav
					a.tmpl1-header__link(href="#tmpl1-about") О ресторане
					a.tmpl1-header__link(href="#menu") Меню
					a.tmpl1-header__link(href="#tmpl1-specialties") Специальности
					a.tmpl1-header__link(href="#tmpl1-footer") Контакты
				a.tmpl1-btn.tmpl1-header__cta(href="#tmpl1-reserve") Забронировать
				button.tmpl1-burger(type="button" aria-label="Меню")
					span
					span
					span
		main#tmpl1-top
			//- ───────────────────── Hero ─────────────────────
			section.tmpl1__hero
				img.tmpl1__hero-bg(src="/img/template/template-1/jumbotron.png" alt="" aria-hidden="true")
				.tmpl1__hero-inner.container
					p.tmpl1__over-title(data-anim) Ресторан авторской кухни
					h1.tmpl1__title(data-anim) LUMIÈRE
					p.tmpl1__lead(data-anim)
						| Ужин при свечах, камин и кухня, где каждый продукт
						|  говорит сам за себя. Вт–Вс · 18:00 — 00:00
					.tmpl1__actions(data-anim)
						a.tmpl1-btn.tmpl1-btn--solid(href="#tmpl1-reserve") Забронировать стол
						a.tmpl1-btn.tmpl1-btn--ghost(href="#menu") Посмотреть меню
					p.tmpl1__note(data-anim) Живая музыка по пятницам · дегустационные сеты по субботам

			//- ───────────────────── О ресторане ─────────────────────
			section.tmpl1__about#tmpl1-about
				.tmpl1__grid.container
					.tmpl1__about-text(data-anim)
						h2.tmpl1__heading О ресторане
						p
							| LUMIÈRE — это сорок мест, открытая кухня и короткое меню,
							|  которое меняется вместе с сезоном. Мы покупаем продукты у
							|  небольших хозяйств, а блюда готовим на живом огне и угольном
							|  гриле.
						p
							| Винная карта собрана сомелье вокруг малых хозяйств Европы
							|  и Грузии — к каждому сету подберём сопровождение.
					.tmpl1__about-media(data-anim)
						img(src="/img/template/template-1/photo-01.webp" alt="Зал ресторана")

			//- ───────────────────── Специальности ─────────────────────
			section.tmpl1-specialties#tmpl1-specialties
				.container
					p.section-subtitle(data-anim) Наши специальности
					h2.section-title(data-anim) Фирменные блюда
					.tmpl1-spec__grid
						article.tmpl1-spec__card(data-anim)
							img(src="/img/template/template-1/Screenshot_13.webp" alt="Рибай Вагю A5")
							.tmpl1-spec__overlay
								span.tmpl1-spec__label Основное блюдо
								h3.tmpl1-spec__name Рибай Вагю A5
						article.tmpl1-spec__card(data-anim)
							img(src="/img/template/template-1/Screenshot_14.webp" alt="Лобстер Термидор")
							.tmpl1-spec__overlay
								span.tmpl1-spec__label Морепродукты
								h3.tmpl1-spec__name Лобстер Термидор
						article.tmpl1-spec__card(data-anim)
							img(src="/img/template/template-1/Screenshot_15.webp" alt="Золотая сфера")
							.tmpl1-spec__overlay
								span.tmpl1-spec__label Десерт
								h3.tmpl1-spec__name Золотая сфера
					.text-center.mt-5(data-anim)
						a.tmpl1-btn.tmpl1-btn--solid(href="#menu") Смотреть всё меню

			//- ───────────────────── Меню ─────────────────────
			section.menu-preview#menu
				.container
					p.section-subtitle(data-anim) Кулинарные наслаждения
					h2.section-title(data-anim) Из нашего меню
					.row
						.col-lg-6(data-anim="right")
							.menu-category
								h3.menu-category-title Закуски
								.menu-item
									.menu-item-info
										h4
											span Фуа-гра на сковороде
											span.menu-badge Выбор шефа
										p С инжирным конфитюром и бриошью
									span.menu-item-price 4 200 ₽
								.menu-item
									.menu-item-info
										h4
											span Тартар из тунца
										p Авокадо, кунжут, заправка юдзу
									span.menu-item-price 3 800 ₽
								.menu-item
									.menu-item-info
										h4
											span Салат с бурратой
										p Сортовые томаты, базиликовое масло, выдержанный бальзамик
									span.menu-item-price 2 800 ₽
						.col-lg-6(data-anim="left")
							.menu-category
								h3.menu-category-title Основные блюда
								.menu-item
									.menu-item-info
										h4
											span Стейк рибай сухого выдержки
											span.menu-badge Хит
										p Выдержка 45 дней, масло из костного мозга, печёный чеснок
									span.menu-item-price 8 500 ₽
								.menu-item
									.menu-item-info
										h4
											span Утка на сковороде
										p Вишнёвый глясе, конфи бедра, дикий рис
									span.menu-item-price 6 800 ₽
								.menu-item
									.menu-item-info
										h4
											span Каре ягнёнка
										p Травяная корочка, рататуй, ягнячий жю
									span.menu-item-price 7 200 ₽
					.text-center.mt-5(data-anim)
						a.btn.btn-outline(href="#") Смотреть полное меню

			//- ───────────────────── Дегустационное меню ─────────────────────
			section.tmpl1-tasting#tasting.container
				p.section-subtitle(data-anim) Камерное путешествие
				h2.section-title.tmpl1-tasting__title(data-anim) Дегустационное меню от шефа
				p.tmpl1-tasting__desc(data-anim)
					| Семь подач. Одна история. Займите место у стола шефа и наблюдайте,
					|  как рождается каждая подача, — камерный ритуал на восемь гостей за вечер.
				ul.tmpl1-tasting__meta(data-anim)
					li
						svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6")
							circle(cx="12" cy="12" r="9")
							path(d="M12 7v5l3 2")
						| Примерно 3 часа
					li
						svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6")
							path(d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2")
							circle(cx="10" cy="7" r="4")
							path(d="M23 21v-2a4 4 0 0 0-3-3.87")
							path(d="M16 3.13a4 4 0 0 1 0 7.75")
						| 8 гостей за посадку
					li
						svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6")
							rect(x="3" y="4" width="18" height="18" rx="2")
							path(d="M16 2v4M8 2v4M3 10h18")
						| Вторник — суббота
				.tmpl1-tasting__track#tmpl1Track
					article.tmpl1-course
						.tmpl1-course__media
							img(src="/img/template/template-1/foto-02.webp" alt="Amuse-Bouche")
							span.tmpl1-course__numeral I
						.tmpl1-course__body
							span.tmpl1-course__label Приветственная подача
							h3.tmpl1-course__name Amuse-Bouche
							p.tmpl1-course__desc Комплимент от шефа: тарталетка с томатом и кремом из бурраты
							.tmpl1-course__pairing
								span Вино к подаче
								b Игристое брют, Валле-де-ла-Луар
					article.tmpl1-course
						.tmpl1-course__media
							img(src="/img/template/template-1/foto-03.webp" alt="Гребешок хоккайдо")
							span.tmpl1-course__numeral II
						.tmpl1-course__body
							span.tmpl1-course__label Первая подача
							h3.tmpl1-course__name Гребешок хоккайдо
							p.tmpl1-course__desc Гребешок ручной выловки, юдзу-кошо, зелёное яблоко и жемчужины оливкового масла
							.tmpl1-course__pairing
								span Вино к подаче
								b Сансер, Долина Луары, 2023
					article.tmpl1-course
						.tmpl1-course__media
							img(src="/img/template/template-1/foto-05.webp" alt="Велюте из грибов")
							span.tmpl1-course__numeral III
						.tmpl1-course__body
							span.tmpl1-course__label Вторая подача
							h3.tmpl1-course__name Велюте из лесных грибов
							p.tmpl1-course__desc Крем из порчини, стружка чёрного трюфеля и фундучное пралине
							.tmpl1-course__pairing
								span Вино к подаче
								b Белое бургундское, Шассань-Монтраше
					article.tmpl1-course
						.tmpl1-course__media
							img(src="/img/template/template-1/photo-01.webp" alt="Палтус")
							span.tmpl1-course__numeral IV
						.tmpl1-course__body
							span.tmpl1-course__label Третья подача
							h3.tmpl1-course__name Палтус в масле
							p.tmpl1-course__desc Линейный палтус, бёрр блан, морская спаржа и осетровая икра
							.tmpl1-course__pairing
								span Вино к подаче
								b Виньо Верде, Алваринью Резерва
					article.tmpl1-course
						.tmpl1-course__media
							img(src="/img/template/template-1/jumbotron.webp" alt="Утиная грудка")
							span.tmpl1-course__numeral V
						.tmpl1-course__body
							span.tmpl1-course__label Основная подача
							h3.tmpl1-course__name Утиная грудка сухого выдержки
							p.tmpl1-course__desc Утка 21-дневной выдержки, ежевичный глясе, сельдерей и обугленный эндивий
							.tmpl1-course__pairing
								span Вино к подаче
								b Бароло, Пьемонт, 2019
					article.tmpl1-course
						.tmpl1-course__media
							img(src="/img/template/template-1/foto-02.webp" alt="Сорбет из маракуйи")
							span.tmpl1-course__numeral VI
						.tmpl1-course__body
							span.tmpl1-course__label Интерлюдия
							h3.tmpl1-course__name Сорбет из маракуйи
							p.tmpl1-course__desc Освежающая пауза: мята и кристаллизованные лепестки фиалки
							.tmpl1-course__pairing
								span Сопровождение
								b Сорбет бузина — юдзу
					article.tmpl1-course
						.tmpl1-course__media
							img(src="/img/template/template-1/foto-03.webp" alt="Mignardises")
							span.tmpl1-course__numeral VII
						.tmpl1-course__body
							span.tmpl1-course__label Финал
							h3.tmpl1-course__name Mignardises
							p.tmpl1-course__desc Сладкое ассорти, petits fours и кофе на выбор
							.tmpl1-course__pairing
								span Вино к подаче
								b Шампань Brut, Шампань
				.container
					.tmpl1-tasting__progress(data-anim)
						span#tmpl1Progress
					p.tmpl1-tasting__hint(data-anim) Перетащите или прокручивайте, чтобы изучить меню
				p.tmpl1-tasting__caption(data-anim) Семикурсовая дегустация

			//- ───────────────────── Бронирование ─────────────────────
			section.tmpl1__reserve#tmpl1-reserve
				.container.tmpl1__reserve-grid
					.tmpl1__reserve-info(data-anim)
						p.section-subtitle.section-subtitle--left Бронирование
						h2.tmpl1__reserve-title Забронируйте свой вечер
						p.tmpl1__reserve-text
							| Займите столик в LUMIÈRE и приготовьтесь к незабываемому
							|  вечеру. Для компаний больше восьми гостей свяжитесь с нами
							|  напрямую — предложим варианты приватного обслуживания.
						p.tmpl1__hours-title Часы работы
						ul.tmpl1__hours
							li
								b Понедельник — четверг:
								|  17:00 — 22:00
							li
								b Пятница — суббота:
								|  17:00 — 23:00
							li
								b Воскресенье:
								|  16:00 — 21:00
						ul.tmpl1__contacts
							li
								svg(width="16" height="16" viewBox="0 0 24 24" fill="currentColor")
									path(d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z")
								a(href="tel:+79000000000") +7 (900) 000-00-00
							li
								svg(width="16" height="16" viewBox="0 0 24 24" fill="currentColor")
									path(d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z")
								a(href="mailto:hello@lumiere.rest") hello@lumiere.rest
					.tmpl1-reserve__frame(data-anim)
						form.tmpl1__reserve-form#tmpl1Reserve(novalidate autocomplete="off")
							label.tmpl1__field
								span Полное имя
								input(type="text" name="name" placeholder="Иван Иванов" autocomplete="off")
							label.tmpl1__field
								span Телефон
								input.phone(type="tel" name="phone" placeholder="+7 (900) 000-00-00" autocomplete="off")
							label.tmpl1__field
								span Дата
								input(type="date" name="date")
							div(data-select="time")
								span.tmpl1__field-label Время
								input(type="hidden" name="time" value="19:00")
								.select
									button.tmpl1__select-btn.select__button(type="button" value="19:00") 19:00
									ul.select__list._collapse
										li.select__list-item(tabindex="0") 17:00
										li.select__list-item(tabindex="0") 18:00
										li.select__list-item._selected(tabindex="0") 19:00
										li.select__list-item(tabindex="0") 20:00
										li.select__list-item(tabindex="0") 21:00
							div(data-select="guests")
								span.tmpl1__field-label Гостей
								input(type="hidden" name="guests" value="2")
								.select
									button.tmpl1__select-btn.select__button(type="button" value="2") 2
									ul.select__list._collapse
										li.select__list-item(tabindex="0") 1
										li.select__list-item._selected(tabindex="0") 2
										li.select__list-item(tabindex="0") 3
										li.select__list-item(tabindex="0") 4
										li.select__list-item(tabindex="0") 5
										li.select__list-item(tabindex="0") 6
										li.select__list-item(tabindex="0") 8+
							div(data-select="occasion" data-optional)
								span.tmpl1__field-label Повод (необязательно)
								input(type="hidden" name="occasion" value="")
								.select
									button.tmpl1__select-btn.select__button(type="button" value="") Выбрать повод
									ul.select__list._collapse
										li.select__list-item(tabindex="0") День рождения
										li.select__list-item(tabindex="0") Юбилей
										li.select__list-item(tabindex="0") Свидание
										li.select__list-item(tabindex="0") Деловой ужин
										li.select__list-item(tabindex="0") Другое
							label.tmpl1__field.tmpl1__field--wide
								span Особые пожелания
								textarea(name="requests" placeholder="Диетические ограничения или особые пожелания…" rows="4")
							button.tmpl1-btn.tmpl1-btn--solid.tmpl1-btn--wide(type="submit") Подтвердить бронирование
						p.tmpl1__form-ok(hidden) Столик забронирован — перезвоним для подтверждения.

			//- ───────────────────── Отзывы ─────────────────────
			section.tmpl1-testimonials#tmpl1-testimonials.container
				p.section-subtitle(data-anim) Отзывы гостей
				h2.section-title.tmpl1-testi__title(data-anim) Что говорят наши гости
				.tmpl1-testi__wrap
					button.tmpl1-testi__arrow.tmpl1-testi__arrow--prev(type="button" data-testi-prev aria-label="Предыдущие отзывы") ‹
					.tmpl1-testi__viewport
						.tmpl1-testi__track
							figure.tmpl1-testi__card
								blockquote.tmpl1-testi__quote
									| С первых шагов внутри понимаешь: тебя ждёт нечто необыкновенное.
									|  Винное сопровождение безупречно, а атмосфера неповторима.
								figcaption.tmpl1-testi__author
									b Михаил Соколов
									span Постоянный гость
							figure.tmpl1-testi__card
								blockquote.tmpl1-testi__quote
									| Я обедала в мишленовских ресторанах по всему миру — LUMIÈRE
									|  достойно стоит в одном ряду с лучшими. Настоящая жемчужина кулинарии.
								figcaption.tmpl1-testi__author
									b Елена Романова
									span Тревел- и лайфстайл-блогер
							figure.tmpl1-testi__card
								blockquote.tmpl1-testi__quote
									| Совершенно особенный гастрономический опыт. Внимание к деталям
									|  в каждом блюде удивляет — шеф создал нечто по-настоящему особенное.
								figcaption.tmpl1-testi__author
									b Дмитрий Ким
									span Фуд-критик, Gourmet Magazine
							figure.tmpl1-testi__card
								blockquote.tmpl1-testi__quote
									| Дегустационный сет — театр вкуса. Каждая подача — маленькое
									|  представление, а вино подобрано безупречно.
								figcaption.tmpl1-testi__author
									b Анна Ветрова
									span Сомелье
							figure.tmpl1-testi__card
								blockquote.tmpl1-testi__quote
									| Приводил сюда партнёров — впечатление гарантировано. Сервис
									|  безупречный, кухня на уровне лучших столиц.
								figcaption.tmpl1-testi__author
									b Игорь Ланской
									span Владелец отеля
							figure.tmpl1-testi__card
								blockquote.tmpl1-testi__quote
									| Каждое блюдо — произведение искусства. Снимала весь вечер
									|  и не устала удивляться деталям.
								figcaption.tmpl1-testi__author
									b Мария Орлова
									span Фотограф
					button.tmpl1-testi__arrow.tmpl1-testi__arrow--next(type="button" data-testi-next aria-label="Следующие отзывы") ›
				.container
					.tmpl1-testi__dots(data-testi-dots)

			//- ───────────────────── Галерея ─────────────────────
			section.tmpl1-gallery#tmpl1-gallery
				.container
					p.section-subtitle(data-anim) Галерея
					h2.section-title.tmpl1-gallery__title(data-anim) Визуальное путешествие
					.tmpl1-gallery__grid
						img(data-anim src="/img/template/template-1/foto-02.webp" alt="Ресторан у моря")
						img(data-anim src="/img/template/template-1/foto-03.webp" alt="Интерьер зала")
						img(data-anim src="/img/template/template-1/foto-05.webp" alt="Винная витрина")
						img(data-anim src="/img/template/template-1/jumbotron.webp" alt="Бар")
						img(data-anim src="/img/template/template-1/photo-01.webp" alt="Банкетный зал")
						img(data-anim src="/img/template/template-1/Screenshot_13.webp" alt="Подача блюда")
				.container
					.text-center.mt-5(data-anim)
						a.btn.btn-outline(href="#") Смотреть всю галерею

			//- ───────────────────── Блог ─────────────────────
			section.tmpl1-blog#tmpl1-blog
				.container
					p.section-subtitle(data-anim) Последние новости
					h2.section-title.tmpl1-blog__title(data-anim) Из нашего блога
					.tmpl1-blog__grid
