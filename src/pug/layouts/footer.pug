					.footer__brand
						a.footer__brand-logo.logo.anchor-link(href="#top")
							i.logo__image
							span.logo__text GUSLI WEB
						p.footer__brand-desc Работаем удалённо по всей России и СНГ — переписка, созвоны и документы онлайн.
				form#footerForm.footer__form.form-card(action="#", method="POST" novalidate="")
					.form-card__row.form-card__row--two-cols
						.form-card__field
							input.form-card__input(type="text", name="name", placeholder="Имя", required="")
						.form-card__field
							input.form-card__input.phone(type="tel", name="phone", placeholder="Телефон", required="")
					.form-card__field
						input.form-card__input(type="email", name="email", placeholder="E-mail", required="")
					.form-card__field.form-card__field--textarea
						textarea.form-card__textarea(name="message", placeholder="Сообщение", rows="4")
					button.button--primary.button(type="submit") Отправить
					p.form-card__ok(hidden="") Спасибо! Заявка собрана — ответим в течение рабочего дня.
			.footer__bottom
				p.footer__copyright © 2026 Gusli Web
				nav.footer__links(aria-label="Правовые документы")
