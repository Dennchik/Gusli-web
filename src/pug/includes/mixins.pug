//-! Mixin Head-Links
mixin style(href)
	link(rel="stylesheet" type="text/css" href=href)
mixin icons(href)
	link(rel="icon" type="image/x-icon" href=href)
mixin script(src)
	script(defer="defer" type="text/javascript" src=src)

//-! Mixin Home-link & attributes --------------------------
mixin homeLink(filename, classes)
	a(href=getWebRoot(filename) + "index.html" class=classes aria-label="home")
		block

//-! mixin iconFont
mixin iconfont(classes, mod)
	i(class='icon-' + classes + ' ' + mod)
		block

//-! Mixin link & attributes --------------------------
mixin link(id, href, name)
	a(class=id, href=href)&attributes(attributes)
		span=name
		block

//-! Mixin link ---------------------------------------
mixin btn-link(type, text, mod)
	- m = mod || ''
	a(class=mod + '' type=type)=text
	block

//-! Mixin iconFont	
mixin picture(src, alt)
	picture
		- var webpSrc = src.replace(/\.[^\.]+$/, '.webp')
		source(srcset=webpSrc type='image/webp')
		img(src=src alt=alt)

//-! Mixin list «rest arguments».
mixin list-item(list, link, alink, name)
	li(class=list)
		a(class=link href=`${alink}`)=name
//-! Sprite SVG --------------------------------------
mixin svg(name, bem, mod)
	- m = mod || ''
	svg(class= name + ' ' + bem + ' ' + mod + ' ')
		use(href=`img/sprites/sprite.svg#${name}`)

//-! Mixin Page Header (заголовок внутренних страниц, например /contacts/) --
mixin page-header(title, text)
	section.page-header
		.page-header__container.container
			nav.page-header__breadcrumbs(aria-label="Хлебные крошки")
				a.page-header__breadcrumb-link(href="/") Главная
				span.page-header__breadcrumb-sep /
				span.page-header__breadcrumb-current= title
			h1.page-header__title= title
			if text
				p.page-header__text= text

//- initialization
- var blocks = {}

mixin set(key)
	- blocks[key] = this.block

//- mixin definition ---------------------------------
mixin layout
	block
	.page__main-content
		if blocks.mainContent
			- blocks.mainContent ()
		else
			//- Do nothing

	.side
		if blocks.side
			- blocks.side()
		else
			//- Do nothing
	+set('main')
	+set('side')

