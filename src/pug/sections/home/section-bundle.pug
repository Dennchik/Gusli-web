.section-bundle#packages
	.section-bundle__body
		.section-bundle__container
			.section-bundle__header.sec-head.in
				.section-bundle__eye-brow
					| Трек A ·
					b пакеты
				h2 Три пакета под ограниченный бюджет
				p Цена фиксируется в договоре до старта. В каждом указано не только что входит, но и что не входит — чтобы
					|  не было сюрпризов на приёмке.
			.section-bundle__tiers.tiers.in
				article.tier.section-bundle__tier
					h3.tier__name Лендинг
					p.tier__who Одна услуга или продукт: проверить спрос и запустить рекламу.
					.tier__price
						b 59 000 ₽
						span фикс, предоплата 50%
					.tier__meta срок 7–10 дней правок 2 круга
					ul
						li Одна страница, до 7 секций, адаптив
						li Прототип и структура под оффер
						li Вёрстка кодом, PageSpeed 90+
						li Форма заявки + Telegram-уведомление
						li Метрика, цели, базовая SEO-разметка
						li.no CMS — правки через нас или разработчика
						li.no Интеграция с CRM
					a.button.button--secondary(href="#quiz" data-pick="Лендинг") Выбрать «Лендинг»
				article.tier.section-bundle__tier.tier--hot
					span.tier__flag ЧАЩЕ ВСЕГО БЕРУТ
					h3.tier__name Сайт
					p.tier__who Несколько услуг и направлений, нужна админка и рост в поиске.
					.tier__price
						b 149 000 ₽
						span фикс, предоплата 50%
					.tier__meta срок 3–4 недели правок 3 круга
					ul
						li До 10 страниц + шаблон посадочной
						li CMS: сами меняете тексты, фото, услуги
						li Дизайн под ваш бренд, не шаблон
						li SEO-база: мета теги, скорость, структура
						li Квиз или калькулятор заявки
						li Аналитика, цели, сквозные UTM
						li.no Интеграция с 1С и складом
					a.button.button--primary(href="#quiz" data-pick="Сайт") Выбрать «Сайт»
				article.tier.section-bundle__tier
					h3.tier__name Сервис
					p.tier__who Каталог, магазин или запись: когда сайт должен что-то уметь, а не только рассказывать.
					.tier__price
						b 290 000 ₽
						span фикс, оплата по 3 этапам
					.tier__meta срок 5–7 недель правок без лимита в спринте
					ul
						li Всё из пакета «Сайт»
						li Каталог с фильтрами и поиском
						li Корзина и онлайн-оплата или запись
						li Интеграция с CRM, выгрузка заявок
						li Личный кабинет клиента (базовый)
						li Нагрузочная проверка и мониторинг
					a.button.button--secondary(href="#quiz" data-pick="Сервис") Выбрать «Сервис»
			.addons.section-bundle__addons
				.addons__head
					div
						h3 Достроить пакет
						p Отметьте, что нужно дополнительно — увидите итоговую вилку до разговора.
					span БАЗА:
						span#baseName  Сайт
						|  -
						span#basePrice 149 000 ₽
				.addons__grid-wrapper
					.addons__grid
						label.addons__item.addon
							input(type="checkbox" data-price="22000")
							div
								span Интеграция с CRM:
								small  Битрикс24, amoCRM
							b +22 000 ₽
						label.addons__item.addon
							input(type="checkbox" data-price="45000")
							div
								span Обмен с 1С:
								small  товары, остатки, цены
							b +45 000 ₽
						label.addons__item.addon
							input(type="checkbox" data-price="18000")
							div
								span Вторая языковая версия:
								small  структура и перевод интерфейса
							b +18 000 ₽
						label.addons__item.addon
							input(type="checkbox" data-price="15000")
							div
								span Квиз-калькулятор:
								small  подбор и расчёт на сайте
							b +15 000 ₽
						label.addons__item.addon
							input(type="checkbox" data-price="25000")
							div
								span Перенос со старого сайта:
								small  контент, товары, редиректы
							b +25 000 ₽
						label.addons__item.addon
							input(type="checkbox" data-price="12000")
							div
								span Поддержка, 1 мес:
								small  правки, обновления, бэкапы
							b +12 000 ₽
				.addons__foot
					span Ориентировочная стоимость сборки
					b#sum 149 000 ₽
			p.section-bundle__disclaimer Цены и сроки — рабочий шаблон структуры. Подставьте свои значения перед
				|  публикацией: карточки пакетов, вилки на первом экране, таблица сравнения и константы в скрипте.