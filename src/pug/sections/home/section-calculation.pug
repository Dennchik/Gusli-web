.section-calculation#custom.light
	.section-calculation__body
		.section-calculation__container
			.section-calculation__header.sec-head.in
				.section-calculation__eye-brow
					| Трек B ·
					b кастом
				h2 Сложный проект: сначала считаем, потом называем цену
				p Мы не даём вилку наугад. Разбиваем работу на этапы: каждый оплачивается отдельно, после каждого вы можете
					|  остановиться и забрать результат — документы, прототипы и код.
			.section-calculation__custom-grid.custom-grid.in
				.section-calculation__crit
					h3 Берём в кастом, если
					ul
						li Нужна логика, которой нет в коробке: подбор, расчёт, бронь
						li Данные живут в 1С, CRM или внутренней системе
						li Несколько ролей: клиент, менеджер, партнёр, админ
						li Есть требования к нагрузке, безопасности или аудиту
						li Проект будет развиваться и нужна архитектура на вырост
					p Если задача не попадает ни в один пункт — честно скажем и предложим пакет. Так дешевле для вас.
				div
					.section-calculation__phases
						.phase
							span.phase__n ЭТАП 1
							div
								h4 Диагностика
								p Созвон 40 минут: задача, текущая система, ограничения. На выходе письменное резюме и решение —
									|  пакет или кастом.
							.phase__price
								span 0 ₽
								small 1–2 дня
						.phase
							span.phase__n ЭТАП 2
							div
								h4 Аналитика и сценарии
								p Интервью, роли пользователей, сценарии, карта данных и интеграций. Документ, с которым можно
									|  идти к любому подрядчику.
							.phase__price
								span от 60 000 ₽
								small 1–2 недели
						.phase
							span.phase__n ЭТАП 3
							div
								h4 Прототип и смета
								p Кликабельный прототип ключевых экранов, выбор архитектуры и постатейная смета с фиксированной
									|  стоимостью работ.
							.phase__price
								span от 90 000 ₽
								small 1–2 недели
						.phase
							span.phase__n ЭТАП 4
							div
								h4 Дизайн-система
								p Компоненты, состояния, адаптив. Не картинки, а готовая к вёрстке система — её же используем
									|  при развитии.
							.phase__price
								span по смете
								small 2–4 недели
						.phase
							span.phase__n ЭТАП 5
							div
								h4 Разработка
								p Фронт, бэкенд, интеграции, тесты. Демо раз в неделю, доступ к репозиторию и стенду с первого
									|  спринта.
							.phase__price
								span по смете
								small 4–12 недель
						.phase
							span.phase__n ЭТАП 6
							div
								h4 Запуск и поддержка
								p Перенос, мониторинг, документация, обучение команды. Дальше — доработки по часам или спринтам.
							.phase__price
								span от 45 000 ₽/мес
								small по договору
					.section-calculation__footer
						a.button.button--accent(href="#brief") Запросить диагностику
						span Бесплатно и ни к чему не обязывает — после неё у вас на руках резюме задачи.