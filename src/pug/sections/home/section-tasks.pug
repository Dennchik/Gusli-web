.section-tasks#tasks
	.section-tasks__body
		.section-tasks__container
			.section-tasks__sec-head
				.eye-brow Кейсы
				h2 Задача → решение → результат
				p Показываем не картинки, а что именно изменили и к чему это привело.
			.section-tasks__items
				article.task
					span.task__tag Пакет «Сайт» · услуги
					h3 Студия растяжки, Обнинск
					dl
						dt Задача
						dd Заявки шли только из соцсетей, сайта не было, стоимость записи росла.
						dt Решение
						dd Сайт на 8 страниц с админкой, расписание, запись на пробное с уведомлением в Telegram.
					.task__res
						div
							b +34%
							span заявок за 2 месяца
						div
							b 21 день
							span от брифа до запуска
				article.task
					span.task__tag Пакет «Лендинг» · B2B
					h3 Монтаж инженерных систем
					dl
						dt Задача
						dd Реклама вела на общий сайт, лид стоил дорого, менеджеры получали нецелевые звонки.
						dt Решение
						dd Отдельный лендинг под одну услугу, квалифицирующий квиз из 4 вопросов, расчёт срока на странице.
					.task__res
						div
							b +27%
							span конверсия в заявку
						div
							b 9 дней
							span срок запуска
				article.task
					span.task__tag Кастом · интеграции
					h3 Оптовый каталог с обменом 1С
					dl
						dt Задача
						dd Менеджеры вручную сверяли остатки и цены, прайс устаревал за день, клиенты заказывали то, чего нет.
						dt Решение
						dd Каталог с личным кабинетом дилера, обмен с 1С каждые 15 минут, индивидуальные цены по договору.
					.task__res
						div
							b 0
							span ручной сверки остатков
						div
							b 6 этапов
							span с отдельной приёмкой
			.related-service
				.related-service__content
					.related-service__column
						span.related-service__mono Смежная услуга
						h3 Нужны фото, видео и рилсы для сайта?
						p Съёмку и продакшн делает Gusli Media — вторая студия нашей группы. Мы работаем вместе: они снимают,
							|  мы верстаем и запускаем. Можно вести одним проектом, но договоры и сметы отдельные.
					.related-service__column
						a.button.button--accent.anchor-link(href="https://gusli-studio.ru/" target='_blank')
							span Перейти на Gusli Media

