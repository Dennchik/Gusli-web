section#pricing.pricing
	.pricing__container.container
		h2.pricing__title.section-title Форматы работы
		.pricing__grid
			.price-card
				.price-card__header
					h3.price-card__title Старт
					p.price-card__subtitle Лендинг + базовый контент
				ul.price-card__features
					li Лендинг до 5 блоков
					li Адаптивная вёрстка
					li Базовый контент: тексты, фото
					li Форма заявки и интеграции
			.price-card.price-card--popular
				.price-card__badge Популярно
				.price-card__header
					h3.price-card__title Бизнес
					p.price-card__subtitle Сайт + фото/видео + упаковка
				ul.price-card__features
					li Корпоративный сайт до 10 страниц
					li Фото/видео контент под ключ
					li Упаковка бизнеса и оффер
					li Подключение аналитики и форм
			.price-card
				.price-card__header
					h3.price-card__title Под ключ
					p.price-card__subtitle Сайт + контент + запуск продвижения
				ul.price-card__features
					li Сайт и контент под ключ
					li Запуск рекламы
					li Аналитика и улучшение конверсии
					li Поддержка и масштабирование