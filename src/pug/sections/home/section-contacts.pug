section#contacts.contact
	.contact__container.container
		.contact__box
			.contact__box-image
				img(src="/img/contacts-bg.png", alt="image")
			.contact__content
				.contact__info
					h2.contact__title Нужен сайт, который реально работает?
					p.contact__text Покажем концепцию, подскажем лучшее решение и поможем быстро
						| стартовать.
					button.button.button--accent Оставить заявку
				form.contact__form.form
					.form__row
						label(for="form-name")
							input.form__input(type="text", placeholder="Ваше имя", id="form-name" )
						label(for="form-phone")
							input.form__input(type="tel", placeholder="Телефон", id="form-phone")
					label(for="mail")
						input.form__input(type="email", placeholder="E-mail" id="mail")
					label(for="message")
						textarea.form__textarea(placeholder="Расскажите о проекте", id="message")
					button.button.button--primary.form__button(type="submit") Отправить заявку
					span.form__note Ответим в течение дня