.section-brief#brief.cta
	.section-brief__body
		.section-brief__container
			.section-brief__line
				.section-brief__eye-brow Заявка
				h2 Начнём с диагностики — она бесплатная
				p.section-brief__lead Заполните бриф за минуту. На созвоне разберём задачу, назовём трек и вилку. Если поймём, что не наша
					|  история — подскажем, к кому идти.
				.section-brief__chan.chan.in(data-rv="")
					a(href="#brief")
						| Telegram · быстрее всего
						span @gusli_web
					a(href="#brief")
						| WhatsApp
						span +7 ··· ··· ·· ··
					a(href="#brief")
						| Почта
						span hello@gusli.web
				p.section-brief__note(style="margin-top: 18px") Не звоним без предупреждения и не добавляем в рассылки.
			.section-brief__line
				form#briefForm.section-brief__form.in(novalidate autocomplete="off")
					.section-brief__row
						label(for="user-name")
							| Имя
							input(id="user-name" type="text" name="user-name" placeholder="Как к вам обращаться"
								autocomplete="off" required)
						label(for="user-phone")
							| Телефон или Telegram
							input.phone(id="user-phone" type="tel" name="contact" placeholder="+7 900 000-00-00 / @nick *"
								autocomplete="off" required)
					div(data-select="task")
						span.select__caption Задача
						input(type="hidden" name="task" value="Сайт компании с админкой")
						.select
							button#brief-task.select__button(type="button" value="Сайт компании с админкой") Сайт компании с админкой
							ul.select__list._collapse
								li.select__list-item(tabindex="0") Лендинг под одну услугу
								li.select__list-item._selected(tabindex="0") Сайт компании с админкой
								li.select__list-item(tabindex="0") Каталог, магазин или запись
								li.select__list-item(tabindex="0") Сервис с кабинетом и интеграциями
								li.select__list-item(tabindex="0") Доработать существующий сайт
					.section-brief__row
						div(data-select="budget")
							span.select__caption Бюджет
							input(type="hidden" name="budget" value="100–200 000 ₽")
							.select
								button#brief-budget.select__button(type="button" value="100–200 000 ₽") 100–200 000 ₽
								ul.select__list._collapse
									li.select__list-item(tabindex="0") до 100 000 ₽
									li.select__list-item._selected(tabindex="0") 100–200 000 ₽
									li.select__list-item(tabindex="0") 200–450 000 ₽
									li.select__list-item(tabindex="0") от 450 000 ₽ или пока не определён
						div(data-select="term")
							span.select__caption Срок
							input(type="hidden" name="term" value="за месяц")
							.select
								button#brief-term.select__button(type="button" value="за месяц") за месяц
								ul.select__list._collapse
									li.select__list-item(tabindex="0") за 1–2 недели
									li.select__list-item._selected(tabindex="0") за месяц
									li.select__list-item(tabindex="0") 1–2 месяца
									li.select__list-item(tabindex="0") срок не критичен
					label Коротко о проекте
						textarea(name="about" placeholder="Что за бизнес, есть ли сайт, какие системы используете"
							autocomplete="off")
					label.section-brief__consent
						input(type="checkbox" name="ok")
						span Согласен на обработку персональных данных и на ответ в мессенджере
					button.button.button--primary(type="submit") Отправить бриф
					p#formErr.section-brief__note Заполните имя, контакт и отметьте согласие.
					p.section-brief__note Ответим в течение рабочего дня. Диагностика — 40 минут,
						|  бесплатно.
				#sentBox.section-brief__sent
					h3 Бриф собран
					p.section-brief__note Демо-страница не отправляет данные на сервер. Скопируйте бриф и пришлите в Telegram — либо
						|  подключите свой обработчик формы.
					pre#sentText
					div(style="display: flex; gap: 10px; flex-wrap: wrap")
						button#copyBtn.button.button--primary Скопировать бриф
						button#againBtn.button.button--accent(style="color: var(--night-text); border-color: var(--night-line);")
							span Изменить