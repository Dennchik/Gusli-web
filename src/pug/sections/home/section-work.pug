.section-work
	.section-work__body
		.section-work__container
			.section-work__header.sec-head.in
				.eye-brow Процесс
				h2 Как проходит работа по пакету
				p Порядок один и тот же, поэтому сроки не едут. Кастом-трек отличается этапами 2–3 — там добавляется аналитика
					|  и отдельная смета.
			.section-work__steps.steps.in
				.step
					span.step__n 01
					h3 Заявка
					p Вы оставляете бриф — задача, бюджет, срок.
					.step__t до 1 дня
				.step
					span.step__n 02
					h3 Диагностика
					p Созвон 40 минут, выбираем трек и фиксируем результат.
					.step__t 1–2 дня
				.step
					span.step__n 03
					h3 Смета и договор
					p Фиксируем состав, цену и даты. Предоплата 50%.
					.step__t 1–2 дня
				.step
					span.step__n 04
					h3 Структура и дизайн
					p Прототип, тексты, макеты. Согласуем до вёрстки.
					.step__t 5–14 дней
				.step
					span.step__n 05
					h3 Разработка
					p Вёрстка, CMS, интеграции, аналитика, тесты.
					.step__t 5–25 дней
				.step
					span.step__n 06
					h3 Запуск и передача
					p Публикация, доступы, инструкция, 14 дней гарантии.
					.step__t 1–3 дня
			p.you-need.in(data-rv="")

				span <b>Что нужно от вас:</b> контакт для связи, доступ к домену
					|  и текущему сайту (если есть), 40 минут на диагностику и один
					|  ответственный человек, который согласовывает. Структуру, тексты и
					|  дизайн берём на себя.