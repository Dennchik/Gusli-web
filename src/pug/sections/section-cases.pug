section.section-cases
	.section-cases__container.container
		.section-cases__head
			h2.section-cases__title Наши Кейсы: Результаты для Клиентов
			p.section-cases__subtitle Посмотрите примеры наших работ и как мы помогаем бизнесу
		.section-cases__grid
			article.section-cases__card
				.section-cases__img
					+picture('/img/case-1.png', 'Сайт для студии')
				h3.section-cases__name Сайт для студии
				p.section-cases__desc Корпоративный сайт, поддержка и продвижение — заявки идут в мессенджер и CRM.
				.section-cases__tags
					span.section-cases__tag.section-cases__tag--accent +105% заявок
					span.section-cases__tag Запуск 10 дней
			article.section-cases__card
				.section-cases__img
					+picture('/img/case-2.png', 'Лендинг для услуг')
				h3.section-cases__name Лендинг для услуг
				p.section-cases__desc Личный бренд и упаковка услуг: приём заявок на консультации с первого дня.
				.section-cases__tags
					span.section-cases__tag.section-cases__tag--accent +86% консультации
					span.section-cases__tag Запуск 13 дней
			article.section-cases__card
				.section-cases__img
					+picture('/img/case-3.png', 'Контент-пакет для бренда')
				h3.section-cases__name Контент-пакет для бренда
				p.section-cases__desc Нейрофотосессия товара, озвучивание, сценарии и консультации по контенту.
				.section-cases__tags
					span.section-cases__tag.section-cases__tag--accent 5 роликов
					span.section-cases__tag Запуск 10 дней
			article.section-cases__card
				.section-cases__img
					+picture('/img/case-1.png', 'Сайт для конверс')
				h3.section-cases__name Сайт для конверс
				p.section-cases__desc Запуск корпоративного сайта с формой заявок для отдела продаж.
				.section-cases__tags
					span.section-cases__tag.section-cases__tag--accent +105% заявок
					span.section-cases__tag Запуск 10 дней
			article.section-cases__card
				.section-cases__img
					+picture('/img/case-2.png', 'Упаковка услуг')
				h3.section-cases__name Упаковка услуг
				p.section-cases__desc Съёмка, фото и контент для соцсетей — полный перезапуск направления.
				.section-cases__tags
					span.section-cases__tag.section-cases__tag--accent +20% конверсия
					span.section-cases__tag Запуск 15 дней
			article.section-cases__card
				.section-cases__img
					+picture('/img/case-3.png', 'Ричстрим и аналитика')
				h3.section-cases__name Ричстрим и аналитика
				p.section-cases__desc Съёмка, разработка митапа, тесты и улучшение конверсии ключевых страниц.
				.section-cases__tags
					span.section-cases__tag.section-cases__tag--accent 7 страниц
					span.section-cases__tag Запуск 10 дней
		.section-cases__more
			button.button.button--secondary(type="button") Посмотреть ещё
